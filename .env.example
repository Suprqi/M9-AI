# ---- Database ----
# PostgreSQL connection string (Neon / Supabase / RDS / local)
DATABASE_URL="postgresql://user:password@localhost:5432/m9ai?schema=public"

# ---- Auth ----
# Secret used to hash session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---- AI Provider ----
# Leave AI_PROVIDER empty or set to "mock" to run the whole product with no API key.
# Set to "anthropic" and provide AI_API_KEY to use the real provider.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="claude-opus-5"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
